<?xml version="1.0"?>
<ruleset name="YAML Custom Fields">
	<description>WordPress Coding Standards for YAML Custom Fields Plugin</description>

	<!-- Check all PHP files in directory tree -->
	<file>.</file>

	<!-- Exclude build files, vendor, and test files -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/.git/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- uninstall.php uses direct SQL for bulk deletion - this is the documented exception -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>uninstall.php</exclude-pattern>
	</rule>

	<!-- Posts with YAML CF data are found with a paginated meta_key EXISTS query (indexed column);
	     the alternative is loading every post and filtering in PHP -->
	<rule ref="WordPress.DB.SlowDBQuery.slow_db_query_meta_query">
		<exclude-pattern>src/Data/Repositories/PostDataRepository.php</exclude-pattern>
	</rule>

	<!-- File uploads: tmp_name is PHP's temporary path, checked with is_uploaded_file() before it is read -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput.InputNotSanitized">
		<exclude-pattern>yaml-custom-fields.php</exclude-pattern>
	</rule>

	<!-- RequestHelper is the single place that reads request superglobals. Callers verify the nonce
	     before reading POST data, and postRaw() values are sanitized per field type by
	     YamlCF\Form\DataSanitizer against the schema. -->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>src/Helpers/RequestHelper.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput.InputNotSanitized">
		<exclude-pattern>src/Helpers/RequestHelper.php</exclude-pattern>
	</rule>

	<!-- Minimum supported PHP version -->
	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
